# AdMob Ad Unit IDs
ANDROID_AD_APP_ID=your-android-ad-app-id
ANDROID_AD_UNIT_ID=your-android-ad-unit-id
IOS_AD_APP_ID=your-ios-ad-app-id
IOS_AD_UNIT_ID=your-ios-ad-unit-id

# Firebase
FIREBASE_PROJECT_NUMBER=your-firebase-project-number
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Android
FIREBASE_ANDROID_API_KEY=your-firebase-android-api-key
FIREBASE_ANDROID_APP_ID=your-firebase-android-app-id

# Firebase iOS (macOS uses these too: both apps have the same bundle ID)
FIREBASE_IOS_API_KEY=your-firebase-ios-api-key
FIREBASE_IOS_APP_ID=your-firebase-ios-app-id

# Firebase Desktop: the web app whose GA4 stream Windows and Linux report to.
# The secret is that stream's Measurement Protocol API secret; without both,
# Windows and Linux send nothing.
FIREBASE_DESKTOP_API_KEY=your-firebase-desktop-api-key
FIREBASE_DESKTOP_APP_ID=your-firebase-desktop-app-id
FIREBASE_DESKTOP_MEASUREMENT_ID=your-firebase-desktop-measurement-id
FIREBASE_DESKTOP_MP_API_SECRET=

# Store / Download Links
LINK_APP_STORE=https://apps.apple.com/us/app/your-app/idXXXXXXXXXX
LINK_TEST_FLIGHT=https://testflight.apple.com/join/XXXXXXXX
LINK_GITHUB=https://github.com/your-org/your-repo
LINK_GOOGLE_PLAY=https://play.google.com/store/apps/details?id=com.example.yourapp
LINK_MICROSOFT_STORE=

# App Settings
UPDATE_FLOWLINE_PERIOD=100
IS_TEST_MODE=false

# Website Links
WEBSITE_SIGN_UP=https://yourapp.com/signup
WEBSITE_DONATION=https://yourapp.com/donate
API_BASE_URL=https://api.yourapp.com
YOUTUBE_CHANNEL=https://www.youtube.com/@UnboundTechCo/videos
